{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWS Environment Desk",
  "version": "1.0.0",
  "identifier": "com.aws.environmentdesk",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; frame-src 'none'; object-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["../dist/icons/icon.png", "../dist/icons/icon.ico", "../dist/icons/icon.icns"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
